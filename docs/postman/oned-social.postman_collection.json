{
  "info": { "name": "OneD Social API", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json" },
  "item": [
    { "name": "Health", "request": { "method": "GET", "url": "{{baseUrl}}/health" } },
    { "name": "Register", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/auth/register", "body": { "mode": "raw", "raw": "{\"name\":\"Demo\",\"username\":\"demo\",\"email\":\"demo@oned.local\",\"password\":\"Password123!\"}" } } },
    { "name": "Smart Feed", "request": { "method": "GET", "url": "{{baseUrl}}/feed/smart?limit=20" } },
    { "name": "Global Search", "request": { "method": "GET", "url": "{{baseUrl}}/search?q=cafe" } }
  ],
  "variable": [{ "key": "baseUrl", "value": "http://localhost:4000/api/v1" }]
}
